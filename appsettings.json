{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AiSettings": {
    "ApiType": "OpenAI",
    "ApiKey": "${OPENAI_API_KEY}",
    "DeploymentName": "gpt-4o-mini",
    "ModelName": "gpt-4o-mini",
    "Endpoint": "https://api.openai.com/v1",
    "MaxTokens": 2000,
    "Temperature": 0.7
  }
}